   "source": [
    "## Cut Collagen Molecule\n",
    "\n",
    "import MDAnalysis as mda\n",
    "\n",
    "u = mda.Universe(\"colmol.pdb\")\n",
    "\n",
    "# Select atoms within z = 0 to x Å\n",
    "cut_atoms = u.select_atoms(\"prop z >= 0 and prop z <= 160\")\n",
    "\n",
    "# Write new PDB\n",
    "with mda.Writer(\"cut_colmol.pdb\", cut_atoms.n_atoms) as w:\n",
    "    w.write(cut_atoms)"
   ]
  }
